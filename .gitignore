# The generated name catalog. Alesis's program names are not ours to
# redistribute: regenerate it locally with tools/extract_catalog.py.
nano/data/catalog.json

# Names read off the unit, cached beside the catalog. The user's own
# machine's contents: a local cache, never committed, written by `r`.
nano/data/live-names.json
live-names.json

# A disposable cache of which port answered last.
config.toml

# Written by `make audit-vulns` while it renders pyproject.toml's
# dependencies into something pip-audit can read. Removed again in the same
# recipe; ignored so an interrupted run cannot leave it to be committed.
.audit-runtime-req.txt
